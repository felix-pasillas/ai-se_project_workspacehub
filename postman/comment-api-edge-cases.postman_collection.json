      "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"content\":\"POSTMAN_EDGE_BASELINE_COMMENT_KEEP_UNTIL_FINAL_DELETE\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/tasks/{{taskId}}/comments", "host": ["{{baseUrl}}"], "path": ["api", "tasks", "{{taskId}}", "comments"] } }
    },
