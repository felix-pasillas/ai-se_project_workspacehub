    {
      "name": "Login as seeded owner",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Seeded owner login succeeds (200)', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200) {", "  const data = pm.response.json().data;", "  pm.collectionVariables.set('token', data.token);", "  pm.collectionVariables.set('loggedInUserId', data.user._id);", "  pm.collectionVariables.set('organizationId', data.user.organizationId);", "}"] } }],
      "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"owner@workspacehub.dev\",\"password\":\"Password123!\"}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
    },
    {
      "name": "Get task ID and generate nonexistent IDs",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Task list succeeds and contains a task (200)', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty; });", "const tasks = pm.response.json().data;", "if (tasks && tasks.length) pm.collectionVariables.set('taskId', tasks[0]._id);", "const randomObjectId = () => Array.from({ length: 24 }, () => '0123456789abcdef'[Math.floor(Math.random() * 16)]).join('');", "pm.collectionVariables.set('nonexistentTaskId', randomObjectId());", "pm.collectionVariables.set('nonexistentCommentId', randomObjectId());", "pm.collectionVariables.set('fakeAuthorId', randomObjectId());", "pm.collectionVariables.set('fakeOrganizationId', randomObjectId());", "pm.collectionVariables.set('fakeTaskId', randomObjectId());"] } }],
      "request": { "method": "GET", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "url": { "raw": "{{baseUrl}}/api/tasks", "host": ["{{baseUrl}}"], "path": ["api", "tasks"] } }
