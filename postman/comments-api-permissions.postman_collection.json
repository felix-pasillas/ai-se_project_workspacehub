    {
      "name": "Owner login",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Owner login returns 200', function () { pm.response.to.have.status(200); });", "pm.collectionVariables.set('ownerToken', pm.response.json().data.token);"] } }],
      "request": { "method": "POST", "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{ownerToken}}", "type": "string" }] }, "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"owner@workspacehub.dev\",\n  \"password\": \"Password123!\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] } }
